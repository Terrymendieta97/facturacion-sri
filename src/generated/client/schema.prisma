// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Issuer {
  id                   Int     @id @default(autoincrement())
  ruc                  String  @unique
  nombres              String
  apellidos            String
  nombreEmpresa        String
  razonSocial          String
  direccion            String  @db.Text
  email                String
  celular              String
  establecimiento      String  @default("001")
  puntoEmision         String  @default("001")
  obligadoContabilidad Boolean @default(false)
  regimen              String  @default("REGIMEN GENERAL")
  ambiente             Int     @default(1) // 1 = Pruebas, 2 = Producción
  firmaElectronica     String? @db.Text // Archivo .p12 codificado en Base64
  codigoSri            String? // Contraseña de la firma .p12
  startSecuencial      String  @default("000000001")

  // Nuevos campos comerciales SaaS
  password         String   @default("123456")
  status           String   @default("ACTIVE") // ACTIVE, SUSPENDED
  planType         String   @default("MONTHLY") // MONTHLY, PAY_PER_INVOICE
  monthlyFee       Float    @default(15.0)
  balance          Float    @default(5.0)
  subscriptionEnds DateTime @default(now())
  logo             String?  @db.Text // Logo de la empresa en Base64

  // API Pública e Integraciones Ecommerce
  apiKey          String?   @unique
  apiKeyCreatedAt DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  invoices        Invoice[]
  clients         IssuerClient[]
  paymentRequests PaymentRequest[]
  emissionPoints  EmissionPoint[]
  products        Product[]
}

model SystemConfig {
  id             Int    @id @default(1)
  adminPassword  String @default("1104759574.1998")
  adminWhatsapp  String @default("593999999999")
  bankAccounts   String @default("Banco Pichincha - Ahorros: 2200123456 (Beneficiario: SRI SaaS)\nBanco Guayaquil - Corriente: 10293847 (Beneficiario: SRI SaaS)") @db.Text
  defaultBalance Float  @default(5.0)

  // Marca y Personalización Visual
  systemName    String  @default("Lojafac")
  pageTitle     String  @default("Lojafac - Facturación Electrónica Ecuador")
  systemLogo    String? @db.Text // Logo en formato Base64
  systemFavicon String? @db.Text // Ícono de la pestaña del navegador (Favicon) en Base64/URL
  loginTitle    String  @default("Lojafac")
  loginSubtitle String  @default("Sistema de Facturación Electrónica Ecuatoriana. Emite facturas, retenciones y guías autorizadas por el SRI al instante.") @db.Text

  // Metadatos SEO
  metaDescription String? @default("Lojafac - Sistema de Facturación Electrónica en Ecuador para personas naturales y empresas autorizadas por el SRI.") @db.Text
  metaKeywords    String? @default("lojafac, facturacion sri, ecuador, facturas electronicas, comprobantes sri, retenciones, guias de remision") @db.Text

  // Configuración de Tarifas y Planes Commerciales
  pricePerInvoice Float @default(0.10) // Precio en dólares por cada factura emitida ($0.10)
  monthlyPlanFee  Float @default(15.0) // Precio en dólares por la suscripción mensual ilimitada ($15.00)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id                    Int      @id @default(autoincrement())
  banco                 String // ej. "Banco Pichincha", "Banco Guayaquil"
  tipoCuenta            String // "Ahorros" o "Corriente"
  numeroCuenta          String // "2200123456"
  titular               String // "FácilSRI SaaS"
  identificacionTitular String? // "1790000000001"
  qrCode                String?  @db.Text // Imagen de Código QR de pago en formato Base64
  activo                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Client {
  id                 Int            @id @default(autoincrement())
  nombres            String
  tipoIdentificacion String // "04" (RUC), "05" (Cédula), "06" (Pasaporte), "07" (Consumidor Final)
  identificacion     String         @unique
  direccion          String         @db.Text
  mail               String
  celular            String
  telefono           String? // Teléfono convencional adicional
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  invoices           Invoice[]
  issuers            IssuerClient[]
}

model IssuerClient {
  id        Int      @id @default(autoincrement())
  issuerId  Int
  clientId  Int
  createdAt DateTime @default(now())

  issuer Issuer @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([issuerId, clientId])
}

model Product {
  id              Int      @id @default(autoincrement())
  nombre          String
  codigoPrincipal String
  descripcion     String?  @db.Text
  precio          Float
  iva             Float    @default(12.0) // Porcentaje de IVA, ej: 12.0, 0.0, 15.0
  imagen          String?  @db.Text // Imagen opcional del producto (Base64)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  issuerId     Int?
  issuer       Issuer?       @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@unique([issuerId, codigoPrincipal])
}

model Invoice {
  id              Int      @id @default(autoincrement())
  secuencial      String // Ej: "000000001" (9 dígitos)
  establecimiento String   @default("001") // 3 dígitos (ej: "001")
  puntoEmision    String   @default("001") // 3 dígitos (ej: "001", "002")
  claveAcceso     String?  @unique // 49 dígitos
  xmlNoFirmado    String?  @db.Text
  xmlAutorizado   String?  @db.Text
  pdfRIDE         String?  @db.Text
  estado          String   @default("CREADA") // CREADA, FIRMADA, RECIBIDA, AUTORIZADA, DEVUELTA, RECHAZADA
  fechaEmision    DateTime
  tipoAmbiente    Int      @default(1) // 1 = Pruebas, 2 = Producción
  subtotal0       Float    @default(0.0)
  subtotalIva     Float    @default(0.0)
  valorIva        Float    @default(0.0)
  total           Float
  formaPago       String   @default("01") // "01" (Sin utilización del sistema financiero), "20" (Otros con utilización del sistema financiero)
  observaciones   String?  @db.Text // Notas u observaciones adicionales del comprobante
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clientId        Int
  client          Client         @relation(fields: [clientId], references: [id])
  issuerId        Int
  issuer          Issuer         @relation(fields: [issuerId], references: [id])
  emissionPointId Int?
  emissionPoint   EmissionPoint? @relation(fields: [emissionPointId], references: [id])
  items           InvoiceItem[]

  @@index([issuerId, fechaEmision])
  @@index([issuerId, estado])
  @@index([issuerId, puntoEmision])
  @@index([clientId])
  @@index([secuencial])
}

model EmissionPoint {
  id               Int      @id @default(autoincrement())
  establecimiento  String   @default("001") // 3 dígitos (ej: "001")
  puntoEmision     String   @default("001") // 3 dígitos (ej: "001", "002")
  nombre           String // ej: "Punto de Venta Principal", "Caja 2 - Mostrador"
  username         String?  @unique // Usuario para login de cajero delegado
  password         String? // Contraseña para login de cajero
  secuencialInicio String   @default("000000001")
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  issuerId Int
  issuer   Issuer    @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([issuerId, establecimiento, puntoEmision])
}

model InvoiceItem {
  id             Int      @id @default(autoincrement())
  cantidad       Float
  precioUnitario Float
  descuento      Float    @default(0.0)
  total          Float
  notaExtra1     String?  @db.Text // Notas extra del ítem (ej. Color)
  notaExtra2     String?  @db.Text // Notas extra del ítem (ej. Empaque)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

model PaymentRequest {
  id             Int       @id @default(autoincrement())
  ruc            String // RUC del emisor que solicita
  razonSocial    String // Razón social del emisor
  monto          Float // Monto del pago
  tipo           String // "TOPUP" (Recarga de Billetera) o "MEMBERSHIP" (Renovación de Membresía)
  referencia     String    @db.Text // Referencia de la transferencia o depósito
  bancoDestino   String // Banco al que transfirió
  estado         String    @default("PENDIENTE") // PENDIENTE, APROBADO, RECHAZADO
  fechaSolicitud DateTime  @default(now())
  fechaProcesado DateTime?

  issuerId Int
  issuer   Issuer @relation(fields: [issuerId], references: [id], onDelete: Cascade)
}
